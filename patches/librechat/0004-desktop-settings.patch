diff --git a/client/src/components/Nav/Settings/Lamplight.tsx b/client/src/components/Nav/Settings/Lamplight.tsx
new file mode 100644
index 00000000..35298c5a
--- /dev/null
+++ b/client/src/components/Nav/Settings/Lamplight.tsx
@@ -0,0 +1,86 @@
+/**
+ * Lamplight: settings of the desktop app shown as tabs of this dialog, so the app has one place for
+ * settings. The tabs embed Lamplight's own settings page (lamplight://app/settings.html), which talks
+ * to the app through its preload; this page itself gets no access to the app beyond the flag below.
+ */
+import { createElement, useEffect } from 'react';
+import { Monitor, Puzzle } from 'lucide-react';
+import type { TabMeta } from './types';
+
+declare global {
+  interface Window {
+    /** Set by the Lamplight desktop app's preload in its main window */
+    lamplightDesktop?: { desktop: boolean };
+    /** Tells the app that this build can open its settings as tabs */
+    __lamplightSettings?: boolean;
+  }
+}
+
+export const LAMPLIGHT_DESKTOP_TAB = 'lamplight-desktop';
+export const LAMPLIGHT_EXTENSIONS_TAB = 'lamplight-extensions';
+export type LamplightTab = typeof LAMPLIGHT_DESKTOP_TAB | typeof LAMPLIGHT_EXTENSIONS_TAB;
+
+export const isLamplightDesktop =
+  typeof window !== 'undefined' && window.lamplightDesktop?.desktop === true;
+
+export const isLamplightTab = (tab: string): tab is LamplightTab =>
+  tab === LAMPLIGHT_DESKTOP_TAB || tab === LAMPLIGHT_EXTENSIONS_TAB;
+
+export const LAMPLIGHT_TABS: TabMeta[] = [
+  {
+    id: LAMPLIGHT_DESKTOP_TAB,
+    labelKey: 'com_nav_setting_desktop',
+    icon: createElement(Monitor, { className: 'icon-sm', 'aria-hidden': true }),
+    sections: [],
+    show: () => isLamplightDesktop,
+  },
+  {
+    id: LAMPLIGHT_EXTENSIONS_TAB,
+    labelKey: 'com_nav_setting_extensions',
+    icon: createElement(Puzzle, { className: 'icon-sm', 'aria-hidden': true }),
+    sections: [],
+    show: () => isLamplightDesktop,
+  },
+];
+
+let requestedTab: LamplightTab | null = null;
+
+/** The tab the app asked for when it opened the dialog (menu bar "設定…" / "拡張機能…"). */
+export function takeRequestedTab(): LamplightTab | null {
+  const tab = requestedTab;
+  requestedTab = null;
+  return tab;
+}
+
+/** Opens the dialog when the app dispatches `lamplight:open-settings` (detail: the tab). */
+export function useLamplightOpenSettings(open: () => void) {
+  useEffect(() => {
+    if (!isLamplightDesktop) {
+      return;
+    }
+    const onOpen = (event: Event) => {
+      const tab = (event as CustomEvent<string>).detail;
+      requestedTab = isLamplightTab(tab) ? tab : LAMPLIGHT_DESKTOP_TAB;
+      open();
+    };
+    window.__lamplightSettings = true;
+    window.addEventListener('lamplight:open-settings', onOpen);
+    return () => {
+      window.__lamplightSettings = false;
+      window.removeEventListener('lamplight:open-settings', onOpen);
+    };
+  }, [open]);
+}
+
+export function LamplightPanel({ tab }: { tab: LamplightTab }) {
+  const theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
+  const view = tab === LAMPLIGHT_EXTENSIONS_TAB ? 'extensions' : 'desktop';
+  return (
+    <iframe
+      key={`${view}-${theme}`}
+      title={view}
+      src={`lamplight://app/settings.html?embed=1&view=${view}&theme=${theme}`}
+      className="block h-[calc(85vh-9.5rem)] w-full border-0 bg-transparent"
+    />
+  );
+}
